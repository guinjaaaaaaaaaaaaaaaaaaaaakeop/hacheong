{
  "type": "object", "additionalProperties": false,
  "required": ["status", "summary", "tests", "support", "covers", "non-claims"],
  "properties": {
    "status": {"enum": ["done", "blocked", "failed"]},
    "summary": {"type": "string"},
    "tests": {"type": "array", "items": {"type": "string", "description": "a test or support file you wrote or changed, as a path relative to target (tests/test_x.py) — a path, never a command"}},
    "support": {"type": "array", "items": {"type": "string", "description": "a helper, fixture or configuration file the tests need that is not itself a test; also listed in tests"}},
    "covers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["section", "tests"],
               "properties": {"section": {"type": "string"}, "tests": {"type": "array", "items": {"type": "string"}}}}},
    "non-claims": {"type": "array", "items": {"type": "string"}}
  }
}
